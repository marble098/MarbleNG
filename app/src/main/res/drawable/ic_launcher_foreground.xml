<?xml version="1.0" encoding="utf-8"?>
<!-- MARBLE_PRISM_MARK_V264 — a faceted hexagonal prism with the M cut out of it.

     Why this shape: V255 reduced the launcher to a thin stroked "M" plus a dot-sized glint. At
     48 dp that read as a letter, not a product — no silhouette, no weight, nothing that survives a
     circular mask or a themed-icon tint. The new mark is one solid object: a rounded hexagonal gem
     with a diagonal ice-white → electric-blue gradient, a one-pixel specular rim, a quiet halo
     ring, and the "M" as a *negative-space* cut so it stays legible at 24 dp and in monochrome.

     Every vertex sits inside the adaptive icon's 66 dp safe circle (radius 32 of the 108 canvas),
     so no launcher mask can crop a corner. There is exactly one colour-carrying layer; the themed
     icon in ic_launcher_monochrome.xml is the same plate and the same cut, white on transparent. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Halo: the ring between R36 and R32, even-odd so it never fills behind the M cut-out. -->
    <path
        android:fillColor="#1C8FD8FF"
        android:fillType="evenOdd"
        android:pathData="M48.80,21.00 L28.02,33.00 Q22.82,36.00 22.82,42.00 L22.82,66.00 Q22.82,72.00 28.02,75.00 L48.80,87.00 Q54.00,90.00 59.20,87.00 L79.98,75.00 Q85.18,72.00 85.18,66.00 L85.18,42.00 Q85.18,36.00 79.98,33.00 L59.20,21.00 Q54.00,18.00 48.80,21.00 Z M49.67,24.50 L30.62,35.50 Q26.29,38.00 26.29,43.00 L26.29,65.00 Q26.29,70.00 30.62,72.50 L49.67,83.50 Q54.00,86.00 58.33,83.50 L77.38,72.50 Q81.71,70.00 81.71,65.00 L81.71,43.00 Q81.71,38.00 77.38,35.50 L58.33,24.50 Q54.00,22.00 49.67,24.50 Z" />

    <!-- The plate. The second subpath is a bold M; even-odd turns it into a cut-out that shows the
         deep navy field, which is what keeps the mark readable at notification scale. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M49.67,24.50 L30.62,35.50 Q26.29,38.00 26.29,43.00 L26.29,65.00 Q26.29,70.00 30.62,72.50 L49.67,83.50 Q54.00,86.00 58.33,83.50 L77.38,72.50 Q81.71,70.00 81.71,65.00 L81.71,43.00 Q81.71,38.00 77.38,35.50 L58.33,24.50 Q54.00,22.00 49.67,24.50 Z M37,68 L37,42 L45,42 L54,58 L63,42 L71,42 L71,68 L63,68 L63,53 L55,64 L53,64 L45,53 L45,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="22"
                android:endX="82"
                android:endY="86"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.5" android:color="#FF9BDEFF" />
                <item android:offset="1" android:color="#FF2563EB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular rim: one hairline following the exact rounded silhouette, no straight overshoot. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M49.67,24.50 L30.62,35.50 Q26.29,38.00 26.29,43.00 L26.29,65.00 Q26.29,70.00 30.62,72.50 L49.67,83.50 Q54.00,86.00 58.33,83.50 L77.38,72.50 Q81.71,70.00 81.71,65.00 L81.71,43.00 Q81.71,38.00 77.38,35.50 L58.33,24.50 Q54.00,22.00 49.67,24.50 Z"
        android:strokeColor="#D9FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.1" />
</vector>
