<?xml version="1.0" encoding="utf-8"?>
<!--
  MarbleNG • the marble.

  One sphere, one orbit. The whole mark stays inside the adaptive-icon safe zone
  (the centre 66dp of the 108dp canvas) so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-24">

        <!-- orbit, behind the marble -->
        <path
            android:fillColor="#00000000"
            android:pathData="M22,54 a32,12.5 0 1,0 64,0 a32,12.5 0 1,0 -64,0"
            android:strokeColor="#3399FF"
            android:strokeAlpha="0.55"
            android:strokeWidth="3.2" />

        <!-- the marble -->
        <path
            android:pathData="M54,32 a22,22 0 1,0 0,44 a22,22 0 1,0 0,-44">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="38"
                    android:startY="34"
                    android:endX="70"
                    android:endY="74"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFFFFFF" />
                    <item android:offset="0.55" android:color="#FFE0FFFF" />
                    <item android:offset="1" android:color="#FFADD8E6" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- inner shading so the sphere reads round, not as a flat dot -->
        <path
            android:fillColor="#0066CC"
            android:fillAlpha="0.20"
            android:pathData="M54,76 a22,22 0 0,0 20.5,-30.5 a26,26 0 0,1 -34,29.2 a22,22 0 0,0 13.5,1.3 z" />

        <!-- specular highlight -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.95"
            android:pathData="M45,42 a7.5,5.5 0 1,0 0.1,0 z" />

        <!-- orbit, in front of the marble -->
        <path
            android:fillColor="#00000000"
            android:pathData="M22,54 A32,12.5 0 0 0 86,54"
            android:strokeColor="#FFFFFFFF"
            android:strokeAlpha="0.92"
            android:strokeWidth="3.2"
            android:strokeLineCap="round" />
    </group>
</vector>
