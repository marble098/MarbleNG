<!--
  MARBLE_NATIVE_ANDROID_V213 — the action icon for the notification's "Disconnect" verb.

  Android hides action icons in the collapsed shade on every modern release, and the platform
  still uses this drawable in the expanded notification, in Wear and in the notification's own
  accessibility tree — where the previous build passed the *status-bar* mark, i.e. the app's own
  logo standing in for the verb "stop". One silhouette, one meaning: a filled square is the
  system's own stop glyph on every transport control Android ships.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.4,7.4 L16.6,7.4 L16.6,16.6 L7.4,16.6 Z" />
</vector>
