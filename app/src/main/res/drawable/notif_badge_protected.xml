<?xml version="1.0" encoding="utf-8"?>
<!-- MARBLE_SHADE_ATELIER_V234 — the protected badge of the ongoing tunnel item.

     One drawing per state instead of one icon for all five: `protected` reads from the badge alone,
     before a single word of the title is parsed. MARBLE_PRISM_MARK_V264 — the 22dp mark inside the
     disc is the same filled hexagonal prism (with its M cut out) as the launcher; the disc alone
     carries the state's tone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#FF146C2E" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <item
        android:width="22dp"
        android:height="22dp"
        android:drawable="@drawable/ic_notification"
        android:gravity="center" />
</layer-list>
