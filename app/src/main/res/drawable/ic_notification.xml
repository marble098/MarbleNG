<?xml version="1.0" encoding="utf-8"?>
<!-- MARBLE_AURORA_SURFACE_V219 — the status-bar mark.

     Notification icons are silhouettes: the system tints one colour and nothing else, so this is
     the prism from ic_marble_prism.xml redrawn on the 24-unit grid with alpha standing in for the
     translucent facet. Same orbit, same folded "M", same single stroke weight, so the tunnel icon
     in the shade and the launcher icon on the home screen are the same drawing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#00000000"
        android:pathData="M2.4,12 a9.6,3.7 0 1,0 19.2,0 a9.6,3.7 0 1,0 -19.2,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.52"
        android:strokeWidth="1.3" />

    <path
        android:fillColor="#45FFFFFF"
        android:pathData="M12,4.6 L17.6,19.4 L12,16.1 Z" />

    <path
        android:fillColor="#00000000"
        android:pathData="M5.6,19.4 L8.4,4.7 L12,12.6 L15.6,4.7 L18.4,19.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.1" />
</vector>
