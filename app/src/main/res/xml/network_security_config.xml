<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Global cleartext stays denied: no remote HTTP, no exceptions. -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- MARBLE_LOCALHOST_CLEARTEXT_V265 — the one exception is loopback. The Xray and sing-box
         local controller APIs (http://127.0.0.1:<port>/...) are plain HTTP by design, and on
         Android 16 and older the base-config above is also applied to 127.0.0.1, which broke
         the sing-box controller path (real-delay test, readiness check, some server tests)
         with CleartextTrafficNotPermitted on every API level MarbleNG supports (minSdk 26).
         Android 17 permits loopback implicitly; this domain-config restores that behaviour
         explicitly and only for the loopback names — public cleartext remains denied. -->
    <!-- includeSubdomains="false" is stated explicitly rather than left implicit: lint's
         NetworkSecurityConfig check treats the missing attribute as a fatal release error
         ("Missing includeSubdomains attribute"), which failed lintVitalRelease and blocked
         the signed-APK build. Semantics are unchanged — only these three loopback hosts
         are exempt, no suffix/wildcard matching is enabled. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
